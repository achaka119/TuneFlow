@page "/"
@implements IAsyncDisposable
@inject LibraryState Library
@inject IJSRuntime JS
<div class="shell">
<aside><a href="/" class="brand"><span class="brand-mark">≋</span> TuneFlow<span class="brand-dot">.</span></a><div class="nav-label">YOUR SPACE</div><nav>@foreach(var item in new[]{"Discover","Search","Favorites","Playlists","History"}){<button class="nav-item @(view==item?"selected":"")" @onclick="()=>Navigate(item)"><span>@NavIcon(item)</span>@item @if(item=="Favorites"){<small>@Library.Favorites.Count</small>}</button>}</nav><div class="sidebar-bottom"><span class="avatar">AK</span><div>Askar Kairatbek<small>Personal library</small></div></div></aside>
<main><header><div><span class="eyebrow">YOUR DAILY SOUNDTRACK</span><p>Good to have you here, Askar <span class="hello">✦</span></p></div><button class="profile" @onclick='()=>Navigate("Playlists")' aria-label="Open your library">AK</button></header>
@if(view=="Discover"){
<section class="hero"><div class="hero-copy"><span class="eyebrow">TUNEFLOW ORIGINALS / VOL. 01</span><h1>Find your<br/><em>frequency.</em></h1><p>A little focus. A new perspective.<br/>A soundtrack for whatever comes next.</p><button class="primary" @onclick="PlayMix">▶ Play your mix</button><span class="hero-caption">6 original sounds. Made for this moment.</span></div><div class="hero-art"><Artwork Track="Library.Tracks[0]" Class="hero-cover" /></div></section>
<div class="section-heading"><h2>Made for your mood</h2><span>A different rhythm for every day</span></div><section class="moods">@foreach(var m in new[]{"Focus","Relax","Energy"}){<button class="mood @(mood==m?"chosen":"")" @onclick="()=>SetMood(m)"><span>@(m=="Focus"?"◎":m=="Relax"?"☽":"ϟ")</span><div><strong>@m</strong><small>@(m=="Focus"?"Space to think":m=="Relax"?"Take it slow":"Keep moving")</small></div><b>↗</b></button>}</section>
<div class="section-heading"><h2>In your rotation</h2><span>Selected for @mood.ToLowerInvariant()</span></div><section class="album-grid">@foreach(var t in Catalog.Mix(mood,Library.Favorites,Library.Tracks).Take(4)){<button class="album-card" @onclick="()=>Play(t)"><Artwork Track="t"/><strong>@t.Title</strong><small>@(t.LocalAudioKey is null ? $"{t.Genre} · {t.Bpm} BPM" : t.Artist)</small><span class="card-play">▶</span></button>}</section>
}
else if(view=="Playlists"){
<div class="section-heading"><div><span class="eyebrow">YOUR COLLECTION</span><h1>Playlists</h1></div><button class="primary" @onclick="()=>OpenCreate()">+ New playlist</button></div>
@if(activePlaylist is {} pid && Library.Playlists.FirstOrDefault(p=>p.Id==pid) is {} pl){<section class="playlist-header"><div><h2>@pl.Name</h2><p>@pl.TrackIds.Count tracks</p></div><button @onclick="()=>OpenRename(pl)" class="secondary">Rename</button><button class="secondary" @onclick="()=>confirmDelete=true">Delete</button><button class="primary" disabled="@(pl.TrackIds.Count==0)" @onclick="()=>PlayPlaylist(pl)">▶ Play</button></section>@if(confirmDelete){<div class="notice">Delete “@pl.Name”? <button @onclick="()=>DeletePlaylist(pl.Id)">Yes, delete</button><button @onclick="()=>confirmDelete=false">Cancel</button></div>}@if(pl.TrackIds.Count==0){<div class="empty"><h2>A blank canvas</h2><p>Use + next to a song in Search to add your first track.</p><button class="secondary" @onclick='()=>Navigate("Search")'>Find music</button></div>}else{<div class="track-list">@foreach(var t in Library.Tracks.Where(t=>pl.TrackIds.Contains(t.Id))){<TrackRow Track="t" CurrentId="@(current?.Id??0)" Favorite="Library.Favorites.Contains(t.Id)" OnPlay="Play" OnLike="Like" Removable="true" OnRemove="id=>Remove(pid,id)" />}</div>}}
<div class="playlist-list">@foreach(var p in Library.Playlists){<button class="playlist-tile" @onclick="()=>SelectPlaylist(p.Id)"><span>≋</span><div><strong>@p.Name</strong><small>@p.TrackIds.Count tracks</small></div><b>↗</b></button>}</div>@if(Library.Playlists.Count==0){<div class="empty"><h2>Your music, your order</h2><p>Create a playlist and collect your favorite sounds.</p></div>}
}
else {
<span class="eyebrow">YOUR MUSIC, WITH YOU</span><h1>@(view=="Search"?"Explore the sounds":view=="Favorites"?"Your favorites":"Recently played")</h1>
@if(view=="Search"){<div class="upload-toolbar"><button class="primary" @onclick="()=>uploadOpen=!uploadOpen">+ Upload song</button><span>MP3, WAV, M4A or OGG · up to 20 MB</span></div>@if(uploadOpen){<UploadPanel OnUploaded="Uploaded" OnClose="()=>uploadOpen=false" />}<label class="search-box"><span>⌕</span><input placeholder="Search songs, genres or moods" aria-label="Search music" @bind="query" @bind:event="oninput" /></label><div class="filters">@foreach(var g in new[]{"All","Electronic","Ambient","Lo-fi","Uploads"}){<button class="@(genre==g?"filter-active":"")" @onclick="()=>genre=g">@g</button>}</div>}
<div class="section-heading"><h2>@(view=="Search"?"Track library":view=="Favorites"?"Saved by you":"Listening history")</h2><span>@Visible().Count() tracks</span></div>
<div class="track-list">@foreach(var t in Visible()){<TrackRow Track="t" CurrentId="@(current?.Id??0)" Favorite="Library.Favorites.Contains(t.Id)" OnPlay="Play" OnLike="Like" OnAdd="OpenAdd" />}</div>@if(!Visible().Any()){<div class="empty"><h2>@(view=="Search"?"No matching sounds":"Nothing here yet")</h2><p>@(view=="Search"?"Try another song, genre or mood.":"Explore the library and play or save a track.")</p><button class="secondary" @onclick='()=>Navigate("Search")'>Explore library</button></div>}
}
<footer>TuneFlow Studio <span>Demo originals + your personal uploads</span></footer></main></div>
<section class="player" aria-label="Music player"><div class="now-playing">@if(current!=null){<Artwork Track="current" Class="small"/><div><strong>@current.Title</strong><small>@current.Artist</small></div><button class="icon @(Library.Favorites.Contains(current.Id)?"liked":"")" aria-label="Like current track" @onclick="()=>Like(current.Id)">@(Library.Favorites.Contains(current.Id)?"♥":"♡")</button>}else{<span class="standby">≋</span><div><strong>Your next favorite awaits</strong><small>Choose a track to begin</small></div>}</div><div class="transport"><div class="transport-buttons"><button class="icon @(shuffle?"liked":"")" aria-label="Shuffle" aria-pressed="@shuffle" @onclick="()=>shuffle=!shuffle">⤨</button><button class="icon" aria-label="Previous track" disabled="@(current==null)" @onclick="Previous">◀</button><button class="play-button" aria-label="@(playing?"Pause":"Play")" @onclick="Toggle">@(playing?"Ⅱ":"▶")</button><button class="icon" aria-label="Next track" disabled="@(current==null)" @onclick="Next">▶</button><button class="icon @(repeat?"liked":"")" aria-label="Repeat track" aria-pressed="@repeat" @onclick="()=>repeat=!repeat">↻</button></div><div class="timeline"><span>@Time(position)</span><input aria-label="Playback position" type="range" min="0" max="@(current?.Duration??32)" step="0.1" value="@position" @onchange="Seek" /><span>@Time(current?.Duration??0)</span></div></div><div class="volume"><span>◖</span><input aria-label="Volume" type="range" min="0" max="1" step="0.05" value="@volume" @oninput="Volume"/><button class="icon" aria-label="Show queue" @onclick="()=>queueOpen=!queueOpen">☷</button></div></section>
@if(queueOpen){<section class="queue"><div class="section-heading"><h2>Up next</h2><button class="icon" aria-label="Close queue" @onclick="()=>queueOpen=false">×</button></div>@foreach(var t in queue){<button class="queue-track" @onclick="()=>Play(t)"><span>@t.Title</span><small>@t.Genre</small></button>}</section>}
@if(message!=null){<div class="toast" role="status">@message <button aria-label="Dismiss notification" @onclick="()=>message=null">×</button></div>}
@if(dialog!=null){<div class="modal-backdrop"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="dialog-title" @onkeydown="DialogKey"><h2 id="dialog-title">@(dialog=="add"?"Add to playlist":dialog=="rename"?"Rename playlist":"New playlist")</h2>@if(dialog=="add"){@foreach(var p in Library.Playlists){<button class="playlist-option" @onclick="()=>AddTo(p.Id)">@p.Name <span>+</span></button>}@if(Library.Playlists.Count==0){<p>Create a playlist first, then add this track.</p><button class="secondary" @onclick="OpenCreate">Create playlist</button>}}else{<label>Playlist name<input id="playlist-name" maxlength="40" @bind="playlistName" @bind:event="oninput" placeholder="e.g. Late night focus" /></label><button class="primary" @onclick="SavePlaylist">Save playlist</button>}@if(dialogError!=null){<p role="alert" class="error">@dialogError</p>}<button class="secondary" @onclick="CloseDialog">Cancel</button></section></div>}
@code {
 string view="Discover",mood="Focus",query="",genre="All"; string? message,dialog,dialogError; string playlistName=""; Guid? activePlaylist,renaming; bool confirmDelete,queueOpen,playing,shuffle,repeat; int adding; Track? current; List<Track> queue=Catalog.Tracks.ToList(); double position,volume=.7; DotNetObjectReference<Home>? reference; bool disposed; bool uploadOpen;
 static string NavIcon(string s)=>s switch {"Discover"=>"◈","Search"=>"⌕","Favorites"=>"♡","Playlists"=>"▤",_=>"◷"};
 void Navigate(string s){view=s;confirmDelete=false;}
 void SelectPlaylist(Guid id){activePlaylist=id;confirmDelete=false;}
 IEnumerable<Track> Visible()=>view switch {"Favorites"=>Library.Tracks.Where(t=>Library.Favorites.Contains(t.Id)),"History"=>Library.History.Select(id=>Library.Tracks.FirstOrDefault(t=>t.Id==id)).OfType<Track>(),_=>Catalog.Search(query,genre,Library.Tracks)};
 protected override async Task OnAfterRenderAsync(bool first){if(first){reference=DotNetObjectReference.Create(this);await JS.InvokeVoidAsync("tune.init",reference);try{var data=await JS.InvokeAsync<string?>("tune.load");if(data!=null)Library.Restore(JsonSerializer.Deserialize<LibrarySnapshot>(data)??throw new ArgumentException("Invalid data"));}catch(Exception e) when(e is JsonException or ArgumentException or JSException){message="Saved library could not be loaded. You can continue with a fresh library.";}StateHasChanged();}}
 async Task Persist(){try{await JS.InvokeVoidAsync("tune.save",JsonSerializer.Serialize(Library.Snapshot()));}catch(JSException){message="Browser storage is unavailable. Changes will last for this session.";}}
 async Task Uploaded(Track track){Library.RegisterUpload(track);await Persist();query="";genre="Uploads";uploadOpen=false;message="Song imported. You can play it, like it or add it to a playlist.";}
 async Task Like(int id){Library.ToggleFavorite(id);await Persist();}
 void SetMood(string m){mood=m;}
 async Task PlayMix(){queue=Catalog.Mix(mood,Library.Favorites,Library.Tracks).ToList();await Play(queue[0]);}
 async Task PlayPlaylist(Playlist p){queue=p.TrackIds.Select(id=>Library.Tracks.First(t=>t.Id==id)).ToList();if(queue.Count>0)await Play(queue[0]);}
 async Task Play(Track t){if(!queue.Any(x=>x.Id==t.Id))queue=Library.Tracks.ToList();current=t;position=0;Library.Record(t.Id);await Persist();try{await JS.InvokeVoidAsync("tune.play",t.Audio,volume);}catch(JSException e){playing=false;message=e.Message.Contains("no longer in browser storage")?"This song is no longer in browser storage. Upload it again.":"Playback could not start. Press Play to retry.";}}
 async Task Toggle(){if(current==null){await PlayMix();return;}try{await JS.InvokeVoidAsync("tune.toggle");}catch(JSException){message="Playback unavailable. Please try again.";}}
 async Task Next(){if(current==null)return;var i=queue.FindIndex(t=>t.Id==current.Id);var next=shuffle&&queue.Count>1?(i+Random.Shared.Next(1,queue.Count))%queue.Count:(i+1)%queue.Count;await Play(queue[next]);}
 async Task Previous(){if(current==null)return;await Play(queue[(Math.Max(0,queue.FindIndex(t=>t.Id==current.Id))+queue.Count-1)%queue.Count]);}
 [JSInvokable] public async Task Ended(){if(disposed)return;if(repeat&&current!=null)await Play(current);else await Next();StateHasChanged();}
 [JSInvokable] public void Progress(double seconds){if(disposed)return;position=seconds;StateHasChanged();}
 [JSInvokable] public void Playback(bool value){if(disposed)return;playing=value;StateHasChanged();}
 [JSInvokable] public void AudioError(){if(disposed)return;playing=false;message="Audio could not load. Choose another track or retry.";StateHasChanged();}
 async Task Seek(ChangeEventArgs e){if(double.TryParse(e.Value?.ToString(),System.Globalization.NumberStyles.Float,System.Globalization.CultureInfo.InvariantCulture,out var n))await JS.InvokeVoidAsync("tune.seek",n);}
 async Task Volume(ChangeEventArgs e){if(double.TryParse(e.Value?.ToString(),System.Globalization.NumberStyles.Float,System.Globalization.CultureInfo.InvariantCulture,out var n)){volume=n;await JS.InvokeVoidAsync("tune.volume",n);}}
 static string Time(double n)=>$"{(int)n/60}:{(int)n%60:00}";
 async Task OpenCreate(){dialog="create";playlistName="";dialogError=null;await Task.Yield();}
 void OpenRename(Playlist p){dialog="rename";renaming=p.Id;playlistName=p.Name;dialogError=null;}
 void OpenAdd(int id){adding=id;dialog="add";dialogError=null;}
 void CloseDialog(){dialog=null;dialogError=null;}
 void DialogKey(KeyboardEventArgs e){if(e.Key=="Escape")CloseDialog();}
 async Task SavePlaylist(){try{if(dialog=="rename"&&renaming is {} id)Library.Rename(id,playlistName);else activePlaylist=Library.Create(playlistName).Id;await Persist();dialog=null;view="Playlists";message="Playlist saved.";}catch(ArgumentException e){dialogError=e.Message;}}
 async Task AddTo(Guid id){Library.Add(id,adding);await Persist();dialog=null;message="Track added to playlist.";}
 async Task Remove(Guid id,int track){Library.Remove(id,track);await Persist();}
 async Task DeletePlaylist(Guid id){Library.Delete(id);activePlaylist=null;confirmDelete=false;await Persist();}
 public async ValueTask DisposeAsync(){disposed=true;try{await JS.InvokeVoidAsync("tune.dispose");}catch(JSDisconnectedException){}reference?.Dispose();}
}

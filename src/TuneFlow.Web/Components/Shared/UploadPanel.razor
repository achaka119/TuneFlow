@inject IJSRuntime JS
@inject LibraryState Library
<section class="upload-panel" aria-label="Import a song" aria-busy="@busy">
 <h2>Add your music</h2><p>Choose an audio file you have permission to use. Songs stay in this browser.</p>
 <div class="upload-fields"><label>Song title<input maxlength="100" @bind="title" disabled="@busy" placeholder="Song title" /></label><label>Artist<input maxlength="100" @bind="artist" disabled="@busy" placeholder="Artist name" /></label></div>
 <label>Audio file<input id="@inputId" type="file" accept=".mp3,.wav,.m4a,.ogg,audio/*" disabled="@busy" /></label>
 @if(error!=null){<p role="alert" class="error">@error</p>}
 @if(busy){<p role="status">Importing and checking audio…</p>}
 <button class="primary" disabled="@busy" @onclick="Import">@(busy?"Importing…":"Import song")</button>
 <button class="secondary" disabled="@busy" @onclick="()=>OnClose.InvokeAsync()">Cancel</button>
</section>
